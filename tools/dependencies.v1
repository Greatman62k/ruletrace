# format: ruletrace-dependencies v1
# One entry per external crate: dep <name> used-by <crates> purpose <text> alternatives <text> status <text>
# Rows are added by the task that adds the dependency (first: sha2 in task 2.3).
dep sha2 used-by rt-hash purpose "SHA-256 (FIPS 180-4), pure Rust and deterministic on all platforms; default features off; wrapped by rt-hash so it can be replaced" alternatives "hand-rolled SHA-256 (risk of subtle bugs); ring (C and asm, larger); std (none)" status "RustCrypto project, widely used, actively maintained; verified against NIST vectors in rt-hash tests"
dep proptest used-by rt-foundation,rt-json,rt-source purpose "property-based testing of Diagnostic ordering (Property 7) and ingestion determinism; dev-dependency only, default features off with std; never in a shipped binary" alternatives "quickcheck (weaker shrinking, no strategy combinators); hand-written generators with a fixed seed (no shrinking, more code)" status "proptest-rs project, widely used, actively maintained; named by the design's testing strategy"
dep serde_json used-by rt-json purpose "dev-only differential oracle for the RT-JSON parser (design §4.1.1, risk R-D3): generated valid and invalid documents must be accepted and rejected as serde_json does; never a normal dependency and never in a shipped binary" alternatives "hand-written reference parser (shares the author's misreadings of RFC 8259); no oracle (R-D3 unmitigated)" status "dtolnay project, widely used, actively maintained; dev-dependency only, so it is outside the check-tree normal-dependency closure of rt-cli"
dep num-bigint used-by rt-tests-core purpose "independent arbitrary-precision oracle for the differential numeric test (design §7.3, Req 20.22, UD-3 test obligation); dev-dependency only, default features off with std, so it is outside the normal-dependency closure of rt-cli and ruletrace" alternatives "hand-written test bigint (shares the author's misreadings, more code); num-rational (adds a crate, hides the arithmetic under test); rug or gmp (C library); i128 only (cannot represent 256-bit intermediates)" status "rust-num project, widely used, actively maintained; pure Rust; dev-only"
# Transitive crates (task 2.11): each is pulled in by the crate named in used-by and is never a direct dependency.
dep autocfg used-by proptest purpose "build-time probe of compiler features, pulled in by num-traits" alternatives "std (none); hand-written build script (more code per crate)" status "rust-lang-nursery project, widely used, maintained; build-time only"
dep bitflags used-by proptest purpose "typed bit flag sets, pulled in by proptest" alternatives "std integers with constants (no type safety)" status "bitflags project, widely used, actively maintained"
dep block-buffer used-by sha2 purpose "block buffering inside the RustCrypto digest stack" alternatives "hand-rolled buffering (bug risk); std (none)" status "RustCrypto project, widely used, actively maintained"
dep cfg-if used-by sha2,proptest,ring purpose "conditional compilation macro used by sha2, ring, rand and getrandom; in both executables through sha2" alternatives "plain cfg attributes (more verbose); std (none)" status "rust-lang project, widely used, maintained"
dep chacha20 used-by proptest purpose "ChaCha generator inside rand, used by proptest to draw test cases" alternatives "own generator (risk of bias); std (no RNG)" status "RustCrypto project, widely used, actively maintained; dev-dependency closure only"
dep core_detect used-by proptest purpose "CPU feature detection pulled in by the rand and chacha20 stack" alternatives "std::arch detection macros (std, not available in every target); none" status "small crate in the rand stack, maintained; dev-dependency closure only"
dep cpufeatures used-by sha2,proptest purpose "runtime CPU feature detection for hardware SHA and ChaCha paths; two versions are locked" alternatives "std::is_x86_feature_detected (x86 only); none" status "RustCrypto project, widely used, actively maintained"
dep crypto-common used-by sha2 purpose "shared traits of the RustCrypto digest stack" alternatives "none, required by digest" status "RustCrypto project, widely used, actively maintained"
dep digest used-by sha2 purpose "Digest trait of the RustCrypto stack, required by sha2" alternatives "none, required by sha2" status "RustCrypto project, widely used, actively maintained"
dep generic-array used-by sha2 purpose "fixed-size arrays with type-level lengths, required by digest 0.10" alternatives "std const generics (not used by this digest version)" status "widely used, maintained; superseded upstream but stable"
dep getrandom used-by proptest,ring purpose "operating-system entropy; two versions are locked: 0.4 for proptest seeds (test builds only) and 0.2 for ring, which ships in ruletrace-ai (ureq and rustls crypto provider)" alternatives "std (no entropy API); fixed seeds only (less coverage, and ring needs entropy)" status "rust-random project, widely used, actively maintained; shipped in ruletrace-ai through ring, not in ruletrace"
dep itoa used-by serde_json,http purpose "integer formatting inside serde_json (test oracle) and inside http, which ureq uses in ruletrace-ai" alternatives "std fmt (slower, same output)" status "dtolnay project, widely used, actively maintained; shipped in ruletrace-ai through http, not in ruletrace"
dep libc used-by proptest,getrandom,cpufeatures purpose "C library bindings on Unix: getrandom and rand (proptest, test builds only), getrandom 0.2 under ring (ruletrace-ai), and cpufeatures under sha2 on aarch64 targets (both executables)" alternatives "std (no entropy or system bindings)" status "rust-lang project, widely used, actively maintained; in ruletrace-ai on Unix, in ruletrace only through cpufeatures on aarch64"
dep memchr used-by serde_json purpose "fast byte search inside serde_json" alternatives "std slice search (slower, same output)" status "BurntSushi project, widely used, actively maintained; dev-only oracle closure"
dep num-traits used-by proptest,num-bigint,num-integer purpose "numeric traits used by proptest strategies" alternatives "own traits (more code)" status "rust-num project, widely used, maintained; dev-dependency closure only"
dep proc-macro2 used-by serde_derive purpose "token handling for derive macros in the optional serde derive feature" alternatives "none; a lockfile entry only, not built without the derive feature" status "dtolnay project, widely used, actively maintained"
dep quote used-by serde_derive purpose "token generation for derive macros in the optional serde derive feature" alternatives "none; a lockfile entry only, not built without the derive feature" status "dtolnay project, widely used, actively maintained"
dep r-efi used-by getrandom purpose "UEFI bindings used by getrandom on UEFI targets only" alternatives "none; never built on supported platforms" status "small crate, maintained; target-specific"
dep rand used-by proptest purpose "random number generation used by proptest; dev-dependency closure only" alternatives "own generator (bias risk); std (no RNG)" status "rust-random project, widely used, actively maintained"
dep rand_core used-by rand,proptest purpose "core RNG traits used by rand and proptest" alternatives "none, required by rand" status "rust-random project, widely used, actively maintained"
dep rand_xorshift used-by proptest purpose "deterministic Xorshift generator that proptest uses for reproducible runs" alternatives "own generator (bias risk); std (no RNG)" status "rust-random project, maintained; dev-dependency closure only"
dep regex-syntax used-by proptest purpose "regular expression parser used by proptest string strategies; the regex engine itself is not used" alternatives "none; required by proptest string strategies" status "rust-lang project, widely used, actively maintained; dev-dependency closure only"
dep serde used-by serde_json purpose "serialization framework required by serde_json; dev-only oracle closure" alternatives "none, required by serde_json" status "serde project, widely used, actively maintained"
dep serde_core used-by serde,serde_json purpose "core traits of serde, required by serde_json" alternatives "none, required by serde_json" status "serde project, widely used, actively maintained"
dep serde_derive used-by serde purpose "derive macros of the optional serde feature; a lockfile entry only" alternatives "hand-written impls; not enabled here" status "serde project, widely used, actively maintained"
dep syn used-by serde_derive purpose "parser for derive macro input in the optional serde derive feature" alternatives "none; a lockfile entry only, not built without the derive feature" status "dtolnay project, widely used, actively maintained"
dep typenum used-by generic-array purpose "type-level numbers, required by generic-array" alternatives "std const generics (not used by generic-array 0.14)" status "widely used, maintained"
dep unarray used-by proptest purpose "array construction helpers used by proptest" alternatives "std array::from_fn (not covering proptest's use at its MSRV)" status "small crate, maintained; dev-dependency closure only"
dep unicode-ident used-by syn,proc-macro2 purpose "identifier character tables used by the proc-macro stack" alternatives "std char::is_alphanumeric (different rules)" status "dtolnay project, widely used, actively maintained"
dep version_check used-by generic-array purpose "build-time compiler version probe used by generic-array" alternatives "hand-written build script" status "widely used, maintained; build-time only"
dep zmij used-by serde_json purpose "float formatting inside serde_json; dev-only oracle closure" alternatives "std fmt (different output); none" status "small crate from the serde_json dependency set, maintained"
dep num-integer used-by num-bigint purpose "integer traits required by num-bigint; dev-dependency closure only" alternatives "none, required by num-bigint" status "rust-num project, widely used, maintained"
# Task 8.4: TOML AI_Configuration parser for rt-ai-tool (design 3.9.2, UD-18). Used only by the auxiliary crate rt-ai-tool, never by a core crate or the ruletrace tree.
dep toml_edit used-by rt-ai-tool purpose "parse-only TOML reader (default features off, only parse) for the AI_Configuration file; keeps byte spans of keys and values so every Diagnostic carries a 1-based line and column (Req 28.3); no serialization, no derive, no serde" alternatives "toml crate (serde based, no per-key spans in the plain API); hand-written strict TOML parser (a second TOML grammar to get wrong, more code, no external review); RT-JSON configuration (UD-18 chose TOML)" status "toml-rs project, widely used (cargo uses it), actively maintained; confined to rt-ai-tool by an external allowed-in line in tools/allowed-edges.v1"
dep toml_parser used-by toml_edit purpose "TOML lexer and parser that toml_edit builds its document on" alternatives "none, required by toml_edit" status "toml-rs project, actively maintained"
dep toml_datetime used-by toml_edit purpose "TOML date and time value type used by toml_edit" alternatives "none, required by toml_edit" status "toml-rs project, actively maintained"
dep winnow used-by toml_parser purpose "parser combinator library under toml_parser" alternatives "none, required by toml_parser" status "winnow-rs project, widely used, actively maintained"
dep indexmap used-by toml_edit purpose "insertion-ordered map that keeps TOML table keys in file order" alternatives "BTreeMap (loses file order); none, required by toml_edit" status "widely used, actively maintained"
dep hashbrown used-by indexmap purpose "hash table under indexmap; never iterated by RuleTrace code" alternatives "std HashMap (not accepted by indexmap); none" status "rust-lang project, widely used, actively maintained"
dep equivalent used-by indexmap purpose "key comparison trait used by indexmap and hashbrown" alternatives "none, required by indexmap" status "small crate by the indexmap authors, maintained"
# Task 10.2: the HTTPS transport of rt-ai-responses and its closure. Only rt-ai-responses depends on ureq and rustls (deny.toml wrappers, check-graph).
dep ureq used-by rt-ai-responses purpose "blocking HTTPS client for the Responses protocol: one POST per attempt, per-request timeout, redirects and proxy detection switchable off; default features off, only `rustls` on, so no gzip, cookies, JSON or native TLS; no async runtime" alternatives "reqwest (pulls tokio and hyper); hyper directly (async, more code); curl bindings (C library); std only (no TLS)" status "maintained by the algesten/ureq project, widely used, active releases; only rt-ai-responses may depend on it (deny.toml wrappers, check-graph forbid-external)"
dep rustls used-by rt-ai-responses,ureq purpose "TLS with certificate chain and host name verification and no way to switch it off in this crate; named directly only to recognise a TLS error inside an io error; default features off, `std` only (ureq enables ring and tls12)" alternatives "native-tls (platform OpenSSL, varying behaviour); no TLS (credential in clear text)" status "rustls project, widely used, actively maintained; memory-safe Rust"
dep webpki-roots used-by ureq purpose "embedded Mozilla root certificate store, so verification does not depend on the platform store and behaves the same on Linux, macOS and Windows" alternatives "platform verifier (differs per platform); webpki-root-certs (same data, different packaging)" status "rustls project, actively maintained; licence CDLA-Permissive-2.0 added to deny.toml for it"
dep rustls-webpki used-by rustls purpose "certificate path and host name verification inside rustls" alternatives "none, required by rustls" status "rustls project, actively maintained"
dep rustls-pki-types used-by rustls,ureq,rustls-webpki,webpki-roots purpose "shared certificate, key and DNS name types of the rustls stack" alternatives "none, required by rustls" status "rustls project, actively maintained"
dep ring used-by rustls,rustls-webpki purpose "cryptographic primitives (the crypto provider that ureq's rustls feature selects); C and assembly, built with cc" alternatives "aws-lc-rs (larger C build, needs CMake or NASM on some platforms); RustCrypto providers (not selectable through ureq's feature set)" status "ring project, widely used, maintained; may only sit under rustls (deny.toml wrappers); builds with a C compiler, which the Windows cross check of task 10.2 exercises"
dep untrusted used-by ring,rustls-webpki purpose "safe parsing of untrusted byte input in ring and webpki" alternatives "none, required by ring" status "briansmith project, widely used, maintained"
dep subtle used-by rustls purpose "constant-time comparison helpers used by rustls" alternatives "hand-written comparison (timing risk)" status "dalek-cryptography project, widely used, maintained"
dep zeroize used-by rustls,rustls-pki-types purpose "clears secret key material from memory on drop, used by rustls" alternatives "none (secrets would stay in memory)" status "RustCrypto project, widely used, actively maintained"
dep ureq-proto used-by ureq purpose "sans-IO HTTP/1.1 protocol state machine of ureq" alternatives "none, required by ureq" status "algesten project, maintained together with ureq"
dep http used-by ureq,ureq-proto purpose "HTTP request, response, header and status types" alternatives "hand-written types (more code, divergence)" status "hyperium project, widely used, actively maintained"
dep httparse used-by ureq-proto purpose "HTTP/1.1 response head parser" alternatives "hand-written parser (security risk)" status "seanmonstar project, widely used, actively maintained"
dep bytes used-by http purpose "byte buffer type used by http" alternatives "Vec<u8> (not what http exposes)" status "tokio project, widely used, actively maintained"
dep base64 used-by ureq purpose "base64 for HTTP header values inside ureq" alternatives "hand-written encoder (more code)" status "marshallpierce project, widely used, maintained"
dep percent-encoding used-by ureq purpose "URL percent encoding inside ureq" alternatives "hand-written (error-prone)" status "servo project, widely used, maintained"
dep log used-by ureq,rustls purpose "logging facade used by ureq and rustls; no logger is installed, so nothing is written" alternatives "none" status "rust-lang project, widely used, actively maintained"
dep utf8-zero used-by ureq purpose "UTF-8 decoding helper used by ureq" alternatives "std::str (not streaming-safe for split sequences)" status "small crate, maintained with ureq"
dep once_cell used-by rustls purpose "lazily initialised values inside rustls, not in RuleTrace code" alternatives "std::sync::OnceLock (rustls supports it only on newer feature sets)" status "matklad project, widely used, maintained"
dep cc used-by ring purpose "build-time C compiler driver used by the ring build script" alternatives "hand-written build script" status "rust-lang project, widely used, actively maintained; build-time only"
dep shlex used-by cc purpose "command line splitting for the cc build script" alternatives "none" status "build-time only, small crate, maintained"
dep find-msvc-tools used-by cc purpose "locates the MSVC toolchain for the cc build script on Windows" alternatives "none" status "build-time only, rust-lang project"
dep wasi used-by getrandom purpose "WASI bindings used by getrandom 0.2 on wasm targets only" alternatives "none; target-specific, never built on supported platforms" status "bytecodealliance project, maintained; target-specific"
dep windows-sys used-by ring,ureq purpose "Windows API bindings used on Windows targets only" alternatives "std (does not cover the calls)" status "microsoft project, widely used, actively maintained; target-specific"
dep windows-targets used-by windows-sys purpose "import library selection for windows-sys; Windows targets only" alternatives "none, required by windows-sys 0.52" status "microsoft project, maintained; target-specific"
dep windows_aarch64_gnullvm used-by windows-targets purpose "per-target import library for windows-targets; only the one matching the target is linked" alternatives "none, required by windows-targets" status "microsoft project, maintained; target-specific"
dep windows_aarch64_msvc used-by windows-targets purpose "per-target import library for windows-targets; only the one matching the target is linked" alternatives "none, required by windows-targets" status "microsoft project, maintained; target-specific"
dep windows_i686_gnu used-by windows-targets purpose "per-target import library for windows-targets; only the one matching the target is linked" alternatives "none, required by windows-targets" status "microsoft project, maintained; target-specific"
dep windows_i686_gnullvm used-by windows-targets purpose "per-target import library for windows-targets; only the one matching the target is linked" alternatives "none, required by windows-targets" status "microsoft project, maintained; target-specific"
dep windows_i686_msvc used-by windows-targets purpose "per-target import library for windows-targets; only the one matching the target is linked" alternatives "none, required by windows-targets" status "microsoft project, maintained; target-specific"
dep windows_x86_64_gnu used-by windows-targets purpose "per-target import library for windows-targets; only the one matching the target is linked" alternatives "none, required by windows-targets" status "microsoft project, maintained; target-specific"
dep windows_x86_64_gnullvm used-by windows-targets purpose "per-target import library for windows-targets; only the one matching the target is linked" alternatives "none, required by windows-targets" status "microsoft project, maintained; target-specific"
dep windows_x86_64_msvc used-by windows-targets purpose "per-target import library for windows-targets; only the one matching the target is linked" alternatives "none, required by windows-targets" status "microsoft project, maintained; target-specific"
