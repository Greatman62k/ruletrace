{
  "name": "ruletrace-reviewer",
  "description": "RuleTrace independent reviewer: reviews a supplied commit range in a separate worktree under ~/review-wt-*, loopback-only test runs, writes one report under docs/reviews/. Cannot commit, push, reset or switch branches.",
  "prompt": "file://./prompts/reviewer.md",
  "tools": [
    "read",
    "write",
    "shell",
    "web"
  ],
  "resources": [
    "file://../steering/product-principles.md",
    "file://../steering/technical-architecture.md",
    "file://../steering/rust-engineering-and-testing.md",
    "file://../steering/rust-engineering-standards.md",
    "file://../steering/testing-integrity-and-anti-gaming.md",
    "skill://.kiro/skills/*/SKILL.md"
  ],
  "permissions": {
    "rules": [
      {
        "capability": "fs_write",
        "match": [
          "**"
        ],
        "exclude": [
          "docs/reviews/*.md"
        ],
        "effect": "deny"
      },
      {
        "capability": "fs_write",
        "match": [
          "docs/reviews/*.md"
        ],
        "effect": "allow"
      },
      {
        "capability": "shell",
        "match": [
          "git push*",
          "git -C * push*",
          "git reset --hard*",
          "git clean*",
          "git checkout -- *",
          "git restore*",
          "git branch -D*",
          "git branch -d*",
          "git tag -d*",
          "git rebase*",
          "git stash drop*",
          "git stash clear*",
          "git remote *",
          "git -C * remote *",
          "git config *",
          "git -C * config *",
          "gh run rerun*",
          "gh run cancel*",
          "gh run delete*",
          "gh workflow *",
          "gh pr create*",
          "gh pr merge*",
          "gh pr close*",
          "gh pr edit*",
          "gh pr comment*",
          "gh pr review*",
          "gh issue create*",
          "gh issue edit*",
          "gh issue close*",
          "gh issue comment*",
          "gh release *",
          "gh repo delete*",
          "gh repo edit*",
          "gh repo create*",
          "gh repo rename*",
          "gh repo fork*",
          "gh secret *",
          "gh variable *",
          "gh gist *",
          "gh api *-X *",
          "gh api *--method*",
          "gh api *-f *",
          "gh api *-F *",
          "gh api *--input*",
          "git commit*",
          "git add*",
          "git switch*",
          "git checkout*",
          "git stash*",
          "git merge*",
          "git cherry-pick*",
          "git am*",
          "git apply*",
          "git revert*",
          "git mv*",
          "git rm*",
          "git branch*",
          "git tag*",
          "git fetch*",
          "git pull*",
          "git -C /home/sam/Desktop/ruletrace*",
          "git --git-dir*",
          "git --work-tree*",
          "cargo test*",
          "cargo run*",
          "cargo nextest*",
          "cargo install*",
          "cargo publish*",
          "cargo update*",
          "cargo add*",
          "cargo remove*"
        ],
        "effect": "deny"
      },
      {
        "capability": "shell",
        "match": [
          "git status*",
          "git diff*",
          "git log*",
          "git show*",
          "git rev-parse*",
          "git ls-files*",
          "git blame*",
          "git grep*",
          "ls*",
          "cat *",
          "head *",
          "tail *",
          "grep *",
          "rg *",
          "wc *",
          "find *",
          "diff *",
          "sha256sum *",
          "sort *",
          "date*",
          "pwd",
          "which *",
          "git worktree *",
          "git -C /home/sam/review-wt-* *",
          "cargo build*",
          "cargo check*",
          "cargo clippy*",
          "cargo metadata*",
          "cargo tree*",
          "cargo deny*",
          "cargo fmt --all -- --check*",
          "rustfmt --edition 2021 --check *",
          "unshare -rn *",
          "CARGO_TARGET_DIR=* unshare -rn *",
          "python3 *",
          "sed -n *",
          "sed -i *review-wt-*",
          "mkdir -p /home/sam/review-*",
          "rm -rf /home/sam/review-wt-*",
          "rm -rf /home/sam/review-target-*",
          "gh run view*",
          "gh run list*",
          "gh api repos/*",
          "curl -s https://*"
        ],
        "effect": "allow"
      }
    ]
  }
}
